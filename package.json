{
  "name": "heartly",
  "version": "1.2.0",
  "type": "module",
  "description": "Heartly - Private, secure couples app with shared gallery and real-time collaborative scratchbook powered entirely by MongoDB",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "windows": "electron electron/main.cjs",
    "app": "electron electron/main.cjs",
    "update:app": "powershell -ExecutionPolicy Bypass -File scripts/sync-installed-app.ps1",
    "sync:app": "powershell -ExecutionPolicy Bypass -File scripts/sync-installed-app.ps1",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "package": "npx --yes @electron/packager . Heartly --platform=win32 --arch=x64 --icon=public/heartly.ico --out=release-builds --overwrite --prune=false",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "concurrently": "^10.0.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.heartly.app",
    "productName": "Heartly",
    "publish": [
      {
        "provider": "github",
        "owner": "Vibhathcross",
        "repo": "Heartly"
      }
    ],
    "asar": false,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      ".env"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/heartly.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Heartly",
      "artifactName": "Heartly-Setup.${ext}"
    }
  }
}
