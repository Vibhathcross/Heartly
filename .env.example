PORT=5000
# Connect to your MongoDB Atlas cluster or local MongoDB instance
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/heartly?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/heartly
JWT_SECRET=heartly_super_secure_jwt_secret_key_2026_duo
NODE_ENV=development

# FreeLLMAPI Integration (Primary AI Muse)
FREELLMAPI_URL=http://localhost:3001/v1
FREELLMAPI_KEY=freellmapi-your-api-key-here
FREELLMAPI_MODEL=auto

# OpenRouter Fallback Integration (Ensures Ema is always active across all partner devices)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=openrouter/free

